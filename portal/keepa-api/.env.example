# Copiar pra .env na VPS (chmod 600) — nunca commitar o .env de verdade.

PORT=3001

# URL pública do Supabase self-hosted (PostgREST + GoTrue) — a mesma que o
# navegador já usa, não um endereço interno do Docker (esse processo roda
# fora do docker-compose do Supabase).
SUPABASE_URL=https://api.yalca.com.br

# service_role key (bypassa RLS) e anon key (usada só pra verificar token
# de usuário via GoTrue) — os mesmos valores já usados nas Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Chave real da API do Keepa.
KEEPA_API_KEY=

# true = usa dados fictícios (mockKeepaResponse), zero custo de token.
KEEPA_MOCK=false

# Origem permitida no CORS — o domínio do portal.
PORTAL_ORIGIN=https://www.yalca.com.br
